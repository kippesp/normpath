# Report the selected compiler and developer environment before feature probes.
message(STATUS
  "np toolchain: ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION} at ${CMAKE_CXX_COMPILER}")
set(_np_generator "${CMAKE_GENERATOR}")
if(CMAKE_GENERATOR_PLATFORM OR CMAKE_GENERATOR_TOOLSET)
  string(APPEND _np_generator
    " [${CMAKE_GENERATOR_PLATFORM} ${CMAKE_GENERATOR_TOOLSET}]")
endif()
message(STATUS "np generator: ${_np_generator}")
message(STATUS "np linker: ${CMAKE_LINKER}")

if(CMAKE_GENERATOR MATCHES "^Visual Studio ")
  set(_np_toolset
    "${CMAKE_VS_PLATFORM_TOOLSET}, MSVC_VERSION=${MSVC_VERSION}, compiler=${CMAKE_CXX_COMPILER_VERSION}")
  if(CMAKE_VS_PLATFORM_TOOLSET_VERSION)
    string(APPEND _np_toolset ", toolset=${CMAKE_VS_PLATFORM_TOOLSET_VERSION}")
  endif()
  set(_np_sdk "${CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION}")
  if(NOT _np_sdk)
    set(_np_sdk "$ENV{WindowsSDKVersion}")
  endif()
  if(NOT _np_sdk)
    set(_np_sdk "not reported")
  endif()
else()
  set(_np_toolset "$ENV{VCToolsVersion}")
  set(_np_sdk "$ENV{WindowsSDKVersion}")
  if(NOT _np_toolset)
    set(_np_toolset "not set (no developer prompt)")
  endif()
  if(NOT _np_sdk)
    set(_np_sdk "not set (no developer prompt)")
  endif()
endif()
message(STATUS "np MSVC: ${_np_toolset}; Windows SDK ${_np_sdk}")
